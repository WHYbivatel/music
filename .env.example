# Frontend. Empty API base means same-origin /v1.
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_BASE_URL=

# Backend. Copy to .env on the server. Do not commit secrets.
DATABASE_URL=postgresql+psycopg://music_esl:change-me@127.0.0.1:5432/music_esl
TEST_DATABASE_URL=postgresql+psycopg://music_esl:change-me@127.0.0.1:5432/music_esl_test
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=music.esl.kz
SECRET_KEY=change-me
COOKIE_SECURE=true
TRUST_PROXY=true
MEDIA_ROOT=/var/lib/music.esl.kz/media
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MUSIC_PROVIDER=mock
REAL_GENERATION_ENABLED=false
ACE_STEP_BASE_URL=
ACE_STEP_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=https://music.esl.kz
SIGNUP_BONUS_TOKENS=0
TEST_SIGNUP_TOKENS=200
DEMO_TOKENS=50
REAL_TRANSFERS_ENABLED=false
PAYMENT_CREDIT_ENABLED=true
DEMO_AUDIO_DIR=/var/www/music.esl.kz/public/audio
MOCK_DELAY_SECONDS=2
RATE_LIMIT_ENABLED=true
